                    </div>
                </div>
            </div>

            <!-- AI EXPLANATION MODAL (GHOST REPLICA) -->
            <div id="aiExplanationModal" class="modal-overlay">
                <div class="modal-content glass-card ai-explanation">
                    <div class="card-header">
                        <span class="mono" id="aiExpTitle">AI_INSIGHTS</span>
                        <span class="close-btn" onclick="closeAIModal()">&times;</span>
                    </div>
                    <div class="modal-body" id="aiExpBody">
                        <!-- Metrics and interpretations will be injected here -->
                    </div>
                    <div class="card-footer mono" style="text-align: center; font-size: 0.7rem; opacity: 0.6;">
                        <i>DOBLE CLICK PARA DESCARTAR PROTOCOLO</i>
                    </div>
                </div>
            </div>

            <!-- HEALTH DASHBOARD MODAL -->
            <div id="healthModal" class="modal-overlay">
                <div class="modal-content glass-card health-dashboard">
                    <div class="card-header">
                        <span class="mono">DIAGNÓSTICO_DE_SALUD_CRÍTICA</span>
                        <span class="close-btn" onclick="closeHealthModal()">&times;</span>
                    </div>
                    <div class="modal-body">
                        <div class="health-grid">
                            <div class="health-score-section">
                                <div class="flex-center" style="height: 150px;">
                                    <svg width="120" height="120" viewBox="0 0 100 100">
                                        <circle class="gauge-bg" cx="50" cy="50" r="40"></circle>
                                        <circle id="healthGaugeFill" class="gauge-fill" cx="50" cy="50" r="40"
                                            style="stroke-dasharray: 251; stroke-dashoffset: 251; transform: rotate(-90deg); transform-origin: center;">
                                        </circle>
                                    </svg>
                                    <div class="gauge-value" id="healthScoreVal">--%</div>
                                </div>
                                <div id="healthStatusText" class="mono" style="text-align: center; margin-top: 10px;">
                                    ---</div>
                            </div>
                            <div class="health-ai-insights">
                                <div class="terminal-box" id="healthAIConsole">
                                    ⏳ INICIANDO PROTOCOLO_SALUD...
                                </div>
                            </div>
                        </div>
                        <div class="health-stats-row" id="healthStatsRow">
                            <!-- Stats will be injected here -->
                        </div>
                        <div class="health-findings-list" id="healthFindings">
                            <!-- Findings will be injected here -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- AUDIT MODAL -->
            <div id="auditModal" class="modal-overlay">
                <div class="modal-content glass-card audit-log">
                    <div class="card-header">
                        <span class="mono" data-i18n="audit_modal_title">REGISTRO_CRÍTICO_DE_AUDITORÍA</span>
                        <span class="close-btn" onclick="closeAuditModal()">&times;</span>
                    </div>
                    <div class="modal-body">
                        <div class="tactical-table-wrapper">
                            <table class="tac-table" id="auditTable">
                                <thead>
                                    <tr>
                                        <th data-i18n="audit_col_time">FECHA_HORA</th>
                                        <th data-i18n="audit_col_usr">USR</th>
                                        <th data-i18n="audit_col_action">ACCIÓN</th>
                                        <th data-i18n="audit_col_service">SERVICIO</th>
                                        <th data-i18n="audit_col_details">DETALLES</th>
                                        <th data-i18n="audit_col_status">ESTADO</th>
                                    </tr>
                                </thead>
                                <tbody id="auditTableBody">
                                    <!-- Logs will be injected here -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- ULTRA-COMPACT SYNC PROGRESS CARD -->
    <div id="syncMiniCard" class="sync-mini-card">
        <div class="mini-card-header">
            <span class="mono">SYNC_PROTOCOL</span>
            <span id="syncPercent" class="mono">0%</span>
        </div>
        <div class="mini-progress-track">
            <div id="syncProgressBar" class="mini-progress-fill"></div>
        </div>
        <div id="syncStatusText" class="mini-status-text mono">INICIALIZANDO...</div>
    </div>

    <!-- GHOST EXPLANATION DIALOG -->
    <div id="ghostOverlay" class="ghost-overlay" onclick="closeGhostExplanation()">
        <div class="ghost-card" onclick="event.stopPropagation()">
            <div class="ghost-header">
                <div class="ghost-title-row">
                    <span class="ghost-glyph">◈</span>
                    <span id="ghostTitle" class="ghost-title">INTEL_INTERPRETATION</span>
                </div>
                <span class="ghost-close" onclick="closeGhostExplanation()">&times;</span>
            </div>
            <div id="ghostContent" class="ghost-body">
                <!-- Dynamic content injected here -->
            </div>
            <div class="ghost-footer">
                <span class="mono">STATUS: DECODED</span>
                <span class="ghost-line"></span>
            </div>
        </div>
    </div>



    <!-- VISUAL CONNECTORS (Background Layer) -->
    <svg class="visual-connectors">
        <path class="connector-line pulse" d="M 260 120 L 300 120" />
        <path class="connector-line pulse" d="M 260 250 L 300 250" />
        <path class="connector-line pulse" d="M 260 400 L 300 400" />
        <path class="connector-line" d="M 260 550 L 300 550" />
    </svg>

    <!-- LOAD BRIDGE BEFORE LOGIC -->
    <script src="qrc:///qtwebchannel/qwebchannel.js"></script>
    <script src="vault_v2_i18n.js"></script>
    <script src="vault_v2_logic.js"></script>
    <script>
        // Trigger initialization once all scripts are loaded
        window.onload = function () {
            if (typeof initBridge === 'function') initBridge();
            if (typeof setupGhostExplanations === 'function') setTimeout(setupGhostExplanations, 1000);
        };
    </script>

</body>

</html>