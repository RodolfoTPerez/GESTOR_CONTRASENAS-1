<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PASS GUARDIAN | Dashboard</title>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Rajdhani:wght@400;500;600;700&family=Orbitron:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="index.css">
    <link rel="stylesheet" href="dashboard.css">
    <link rel="stylesheet" href="vault_v2.css">
    <link rel="stylesheet" href="vault_v2_core.css">

</head>

<body>

    <!-- VISUAL CONNECTORS (DYNAMIC SVG) -->
    <svg id="svg-connectors"
        style="position:fixed; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:90;">
        <path id="dynamic-connector" d="" stroke="var(--primary)" stroke-width="1.5" fill="none" opacity="0.4"
            stroke-dasharray="4,4" />
    </svg>

    <div class="app-container">
        <!-- SVG Global Effects -->
        <svg style="width:0; height:0; position:absolute;">
            <defs>
                <linearGradient id="gaugeGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" style="stop-color:var(--accent-1); stop-opacity:1" />
                    <stop offset="100%" style="stop-color:var(--accent-4); stop-opacity:1" />
                </linearGradient>
            </defs>
        </svg>

        <aside class="sidebar">
            <div class="sidebar-logo">PASS GUARDIAN</div>

            <div class="sidebar-nav">
                <div class="nav-item active" onclick="switchView('dashboard')">
                    <span class="nav-icon">📊</span>
                    <span data-i18n="nav_dashboard">DASHBOARD</span>
                </div>
                <div class="nav-item" onclick="switchView('vault')">
                    <span class="nav-icon">🔐</span>
                    <span data-i18n="nav_vault">VAULT</span>
                </div>
                <div class="nav-item" onclick="switchView('ai_side')">
                    <span class="nav-icon">🧠</span>
                    <span data-i18n="nav_ai_guardian">AI GUARDIAN</span>
                </div>
                <div class="nav-item" onclick="switchView('activity')">
                    <span class="nav-icon">📜</span>
                    <span data-i18n="nav_activity">ACTIVITY LOG</span>
                </div>
                <div class="nav-item" onclick="switchView('users')">
                    <span class="nav-icon">👥</span>
                    <span data-i18n="nav_users">ADMIN PANEL</span>
                </div>
                <div class="nav-item" onclick="switchView('settings')">
                    <span class="nav-icon">⚙️</span>
                    <span data-i18n="nav_settings">SETTINGS</span>
                </div>
            </div>

            <div class="brightness-control">
                <label data-i18n="brightness_lbl">BRIGHTNESS_LEVEL</label>
                <input type="range" id="brightness" min="0.6" max="1.6" step="0.01" value="1">
            </div>
        </aside>

        <main class="main-viewport">

            <div id="view-dashboard" class="view-pane">
                <!-- TOP HUD BAR -->
                <div class="hud-header-v2">
                    <span class="badge-security" data-i18n="aes_encrypted">AES-256 ENCRYPTED</span>
                    <div class="title-main" id="globalCompanyTitle" data-i18n="it_security">IT SECURITY</div>
                    <div class="widgets">
                        <span id="clock"
                            style="font-family: var(--font-title); color: var(--tactical-blue); font-size: 14px;">00:00:00</span>
                    </div>
                </div>

                <div class="dashboard-layout-v2">
                    <!-- ROW 1: TOP BENTO STATS -->
                    <div class="stats-bento-row">
                        <div class="stat-card-v2">
                            <small data-i18n="admin_secrets">ADMIN SECRETS</small>
                            <div class="value" id="valAdmin" style="font-family: var(--font-title);">0</div>
                        </div>
                        <div class="stat-card-v2">
                            <small data-i18n="user_secrets">USERS SECRETS</small>
                            <div class="value" id="valUser" style="font-family: var(--font-title);">20</div>
                        </div>
                        <div class="stat-card-v2">
                            <small data-i18n="total_users_lbl">TOTAL USERS</small>
                            <div class="value" id="valUsers" style="font-family: var(--font-title);">3</div>
                        </div>
                        <div class="stat-card-v2">
                            <small data-i18n="sessions_lbl">SESSIONS</small>
                            <div class="value" id="valSessions" style="font-family: var(--font-title);">1</div>
                        </div>
                        <div class="stat-card-v2">
                            <small data-i18n="logs_lbl">LOGS</small>
                            <div class="value" id="valLogs" style="font-family: var(--font-title);">463</div>
                        </div>
                    </div>

                    <!-- ROW 2: HUD MIDDLE LAYER -->
                    <div class="middle-hud-row">

                        <!-- GLOBAL SECURITY STATE -->
                        <div class="hud-pane">
                            <div class="hud-pane-header">
                                <span data-i18n="global_security_title">ESTADO GLOBAL DE SEGURIDAD</span>
                                <span data-i18n="core_active">[NÚCLEO_ACTIVO]</span>
                            </div>

                            <!-- Centering Wrapper -->
                            <div style="flex: 1; display: flex; align-items: center; justify-content: center;">
                                <div
                                    style="display: grid; grid-template-columns: 1fr 1.5fr; gap: 24px; align-items: center; width: 100%; max-width: 550px;">
                                    <!-- Gauge Side -->
                                    <div style="display: flex; justify-content: center; position: relative;">
                                        <svg width="140" height="140" viewBox="0 0 100 100">
                                            <circle cx="50" cy="50" r="45" fill="none" stroke="rgba(255,255,255,0.05)"
                                                stroke-width="6" />
                                            <circle id="securityGauge" cx="50" cy="50" r="45" fill="none"
                                                stroke="var(--tactical-teal)" stroke-width="8" stroke-dasharray="283"
                                                stroke-dashoffset="283"
                                                style="filter: drop-shadow(0 0 10px var(--tactical-teal)); transform: rotate(-90deg); transform-origin: center; transition: stroke-dashoffset 1s ease;" />
                                        </svg>
                                        <div id="securityScoreVal" class="value-large-display"
                                            style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-family: var(--font-title);">
                                            --</div>
                                    </div>

                                    <!-- Metrics Side -->
                                    <div class="security-metrics-side">
                                        <div class="row-tactical-text">
                                            <span data-i18n="core_health">ESTADO DEL NÚCLEO / CORE HEALTH</span>
                                            <span id="coreHealthVal" class="mono-value">--%</span>
                                        </div>
                                        <div class="row-tactical-text">
                                            <span data-i18n="access_integrity">INTEGRIDAD / ACCESS INTEGRITY</span>
                                            <span id="accessIntegrityVal" class="mono-value">--%</span>
                                        </div>
                                        <div class="row-tactical-text">
                                            <span data-i18n="encryption_level">CIFRADO / ENCRYPTION</span>
                                            <span class="mono-value">AES-256 GCM 🛡️</span>
                                        </div>
                                        <div class="row-tactical-text">
                                            <span data-i18n="memory_load">MEMORIA / MEMORY LOAD</span>
                                            <span id="memMbVal" class="mono-value">-- MB 📑</span>
                                        </div>
                                        <div class="row-tactical-text">
                                            <span data-i18n="risk_exposure">RIESGO / RISK EXPOSURE</span>
                                            <span id="riskExpVal" class="mono-value">-- 🛡️</span>
                                        </div>
                                        <div class="row-tactical-text">
                                            <span data-i18n="audit_protocol">AUDITORÍA / AUDIT PROTOCOL</span>
                                            <span id="auditProtVal" class="mono-value">OK ✅</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div data-i18n="protection_reinforced"
                                style="margin-top: 15px; padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.05); font-size: 0.65rem; color: var(--tactical-teal); letter-spacing: 2px;">
                                PROTECCIÓN: REFORZADA
                            </div>
                        </div>

                        <!-- RIGHT PANE: AI GUARDIAN -->
                        <div class="hud-pane">
                            <div class="hud-pane-header">
                                <span data-i18n="ai_guardian_title">AI_GUARDIAN / GUARDIÁN_IA</span>
                                <span id="aiRiskCount" style="color: var(--tactical-danger); font-size: 11px;">🛡️ 0
                                    <span data-i18n="risks">RISKS</span></span>
                            </div>
                            <div
                                style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; height: calc(100% - 40px);">
                                <div class="spider-chart-container">
                                    <!-- Orbital Labels Layer -->
                                    <div class="orbital-labels">
                                        <div class="o-label top"><span data-i18n="o_strength">STRENGTH</span> <span
                                                id="valFort" style="color:var(--tactical-blue)">--%</span></div>
                                        <div class="o-label tl"><span data-i18n="o_risk">RISK</span> <span id="valRisk"
                                                style="color:#ff003c">--%</span></div>
                                        <div class="o-label tr"><span data-i18n="o_identity">IDENTITY</span> <span
                                                id="valIdent" style="color:var(--tactical-blue)">--%</span></div>
                                        <div class="o-label ml"><span data-i18n="o_logs">LOGS</span> <span id="valReg"
                                                style="color:var(--tactical-blue)">--%</span></div>
                                        <div class="o-label mr"><span data-i18n="o_health">HEALTH</span> <span
                                                id="valHealth" style="color:var(--tactical-blue)">--%</span></div>
                                        <div class="o-label bl"><span data-i18n="o_cloud">CLOUD</span> <span
                                                id="valCloud" style="color:var(--tactical-blue)">--%</span></div>
                                        <div class="o-label br"><span data-i18n="o_rotation">ROTATION</span> <span
                                                id="valRot" style="color:var(--tactical-blue)">--%</span></div>
                                        <div class="o-label bottom"><span data-i18n="o_intel">INTELLIGENCE</span> <span
                                                id="valIntel" style="color:var(--tactical-blue)">--%</span></div>
                                    </div>

                                    <div class="radar-container">
                                        <div class="radar-ripple"></div>
                                        <div class="radar-ripple"></div>
                                        <div class="radar-sweep"></div>
                                        <div class="radar-circle"></div>
                                        <div class="radar-circle" style="width: 66%; height: 66%;"></div>
                                        <div class="radar-circle" style="width: 33%; height: 33%;"></div>
                                        <div class="radar-crosshair-h"></div>
                                        <div class="radar-crosshair-v"></div>
                                        <div class="radar-center-dot"></div>
                                        <div class="radar-crosshair-d1"></div>
                                        <div class="radar-crosshair-d2"></div>

                                        <!-- Spider Chart Overlay -->
                                        <svg id="radarSpiderChart" viewBox="0 0 100 100"
                                            style="position:absolute; width:100%; height:100%; top:0; left:0; z-index:3; pointer-events:none; filter: drop-shadow(0 0 5px var(--tactical-blue));">
                                            <polygon points="" fill="rgba(0, 242, 255, 0.2)"
                                                stroke="var(--tactical-blue)" stroke-width="1.5"
                                                style="transition: all 0.5s ease-out; stroke-linejoin: round;" />
                                        </svg>

                                        <div id="radarBlips"></div>
                                    </div>

                                    <div class="radar-status-text" data-i18n="tactical_radar_live">TACTICAL RADAR: LIVE
                                    </div>
                                </div>
                                <div class="intel-feed" id="aiIntelFeed">
                                    <div data-i18n="real_time"
                                        style="font-size: 10px; color: var(--tactical-danger); margin-bottom: 8px; font-weight: 700;">
                                        [REAL_TIME]</div>
                                    <div class="intel-alert">
                                        <div class="alert-title" data-i18n="ai_alert_title">Critical vulnerability
                                            detected in 1 vault</div>
                                        <div class="alert-actions">
                                            <button class="intel-btn" onclick="vaultBridge.trigger_ai_audit()"
                                                data-i18n="btn_apply">APPLY</button>
                                            <button class="intel-btn" onclick="openAuditModal()"
                                                data-i18n="btn_review">REVIEW</button>
                                            <button class="intel-btn" data-i18n="btn_ignore">IGNORE</button>
                                        </div>
                                    </div>
                                    <div style="font-size: 9px; line-height: 1.5;">
                                        <div style="color: var(--tactical-warning)" data-i18n="ai_warn_1">> WARNING:
                                            Degraded security posture</div>
                                        <div style="color: var(--tactical-warning)" data-i18n="ai_warn_2">> 15 keys with
                                            weak entropy identified</div>
                                        <div style="color: var(--tactical-warning)" data-i18n="ai_warn_3">> 1 key found
                                            in multiple clusters</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ROW 3: QUAD METRICS -->
                    <div class="bottom-metrics-row" style="grid-template-columns: repeat(3, 1fr);">
                        <!-- ACCESS SECURITY (Existing) -->
                        <div class="metric-card-small" id="accessSecurityCard">
                            <h4 data-i18n="access_security_title">SEGURIDAD DE ACCESO</h4>
                            <!-- ... content ... -->
                            <div class="prog-v2-header" style="margin-top: 5px;"><span
                                    data-i18n="mfa_coverage">COBERTURA MFA</span><span id="mfaCoverageVal">0 / 0
                                    🛡️</span></div>
                            <div class="prog-v2-track">
                                <div class="prog-v2-fill teal" style="width: 0%"></div>
                            </div>

                            <div class="prog-v2-header" style="margin-top: 10px;"><span data-i18n="admin_sec">SEGURIDAD
                                    DE ADMIN</span><span
                                    style="color: var(--tactical-teal); font-family: var(--font-mono); font-weight: 700;">SECURE
                                    🛡️</span></div>
                            <div class="prog-v2-header" style="margin-top: 10px;"><span
                                    data-i18n="active_sessions">SESIONES ACTIVAS</span><span id="activeSessionsVal"
                                    style="color: var(--tactical-warning); font-family: var(--font-mono); font-weight: 700;">1
                                    ACTIVE ⚡</span></div>
                            <div class="prog-v2-header" style="margin-top: 10px;"><span data-i18n="sec_policy">POLÍTICA
                                    DE
                                    SEGURIDAD</span><span
                                    style="font-family: var(--font-mono); font-weight: 700;">BUSINESS STD 🏢</span>
                            </div>

                            <div class="prog-v2-container" style="margin-top: 10px;">
                                <div class="prog-v2-header"><span data-i18n="login_attempts">INTENTOS LOGIN</span><span
                                        id="loginAttemptsVal" class="mono-value">0 ATTEMPTS ⚡</span></div>
                                <div class="prog-v2-track">
                                    <div class="prog-v2-fill blue" style="width: 5%"></div>
                                </div>
                            </div>

                            <div class="prog-v2-header" style="margin-top: 10px;"><span data-i18n="last_incident">ÚLTIMO
                                    INCIDENTE</span><span id="lastIncidentVal"
                                    style="font-family: var(--font-mono); font-weight: 700;">--
                                    ✅</span></div>
                        </div>

                        <!-- PASSWORD HEALTH (v3) -->
                        <div class="metric-card-small" id="v3HealthCard"
                            style="min-height: 240px; position: relative; overflow: hidden;">
                            <h4>
                                <span data-i18n="pass_health_title">PASSWORD HEALTH</span>
                                <button class="v3-pill-btn" onclick="openHealthDashboard()"><span
                                        data-i18n="fix_issues_btn">REPARAR</span> &rarr;</button>
                            </h4>

                            <div class="v3-main-row">
                                <!-- Left Column: Weak/Strong -->
                                <div class="v3-metric-col">
                                    <div class="v3-metric-box">
                                        <div class="v3-indicator-line red"></div>
                                        <div class="v3-meta">
                                            <div id="valWeak" class="v3-num red">0</div>
                                            <div class="v3-sub" data-i18n="weak_lbl">DÉBILES</div>
                                        </div>
                                    </div>
                                    <div class="v3-metric-box">
                                        <div class="v3-indicator-line teal"></div>
                                        <div class="v3-meta">
                                            <div id="valStrong" class="v3-num teal">0</div>
                                            <div class="v3-sub" data-i18n="strong_lbl">FUERTES</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Center Column: Gauge (HUD Standard r=45) -->
                                <div class="v3-gauge-col">
                                    <div class="v3-gauge-wrap">
                                        <svg viewBox="0 0 100 100">
                                            <!-- Segmented Background -->
                                            <circle class="v3-gauge-bg" cx="50" cy="50" r="45" />
                                            <!-- Dynamic Fill Arc -->
                                            <circle id="v3HealthGauge" class="v3-gauge-fill" cx="50" cy="50" r="45"
                                                style="stroke-dasharray: 283; stroke-dashoffset: 283;" />
                                        </svg>
                                        <div class="v3-score-wrap">
                                            <div id="vaultScoreVal" class="v3-score-num">0</div>
                                            <div class="v3-score-label" data-i18n="health_lbl">SALUD</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Right Column: Repeated/Expired -->
                                <div class="v3-metric-col align-right">
                                    <div class="v3-metric-box">
                                        <div class="v3-meta text-right">
                                            <div id="valRep" class="v3-num">0</div>
                                            <div class="v3-sub" data-i18n="repeated_lbl">REPETIDAS</div>
                                        </div>
                                        <div class="v3-indicator-line gray"></div>
                                    </div>
                                    <div class="v3-metric-box">
                                        <div class="v3-meta text-right">
                                            <div id="valExp" class="v3-num">0</div>
                                            <div class="v3-sub" data-i18n="expired_lbl">EXPIRADAS</div>
                                        </div>
                                        <div class="v3-indicator-line gray"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="v3-footer">
                                <div class="v3-status-dots">
                                    <span class="v3-dot active"></span>
                                    <span class="v3-dot active"></span>
                                    <span class="v3-dot active"></span>
                                    <span class="v3-dot"></span>
                                    <span id="healthStatusText" class="v3-status-label teal">GOOD</span>
                                </div>
                                <div class="v3-timestamp"><span data-i18n="last_scan">Último escaneo:</span> <span
                                        id="lastScanTime" data-i18n="just_now">AHORA MISMO</span></div>
                            </div>
                        </div>

                        <!-- VIGILANCIA DE SEGURIDAD (New 3rd Column) -->
                        <div class="metric-card-small" id="secWatchCard"
                            style="min-height: 240px; position: relative; overflow: hidden;">
                            <h4>
                                <span data-i18n="sec_watch_title">VIGILANCIA DE SEGURIDAD</span>
                                <span id="watch_AlertsCount" style="color: var(--tactical-danger); font-size: 10px;">0
                                    RISKS</span>
                            </h4>

                            <div class="v3-main-row" style="padding-top: 10px;">
                                <!-- Left: Progress Bars -->
                                <div class="v3-metric-col" style="flex: 1.2;">
                                    <div class="prog-v2-container">
                                        <div class="prog-v2-header"><span>STRENGTH</span><span
                                                id="watch_StrengthVal">--%</span></div>
                                        <div class="prog-v2-track">
                                            <div id="watch_StrengthBar" class="prog-v2-fill cyan" style="width: 0%">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="prog-v2-container">
                                        <div class="prog-v2-header"><span>AUTH</span><span id="watch_AuthVal">--%</span>
                                        </div>
                                        <div class="prog-v2-track">
                                            <div id="watch_AuthBar" class="prog-v2-fill teal" style="width: 0%"></div>
                                        </div>
                                    </div>
                                    <div class="prog-v2-container">
                                        <div class="prog-v2-header"><span>SYNC</span><span id="watch_SyncVal">--%</span>
                                        </div>
                                        <div class="prog-v2-track">
                                            <div id="watch_SyncBar" class="prog-v2-fill teal" style="width: 0%"></div>
                                        </div>
                                    </div>
                                    <div class="prog-v2-container">
                                        <div class="prog-v2-header"><span>HEALTH</span><span
                                                id="watch_HealthVal">--%</span></div>
                                        <div class="prog-v2-track">
                                            <div id="watch_HealthBar" class="prog-v2-fill red" style="width: 0%"></div>
                                        </div>
                                    </div>
                                    <div class="prog-v2-container">
                                        <div class="prog-v2-header"><span>ROTATION</span><span
                                                id="watch_RotVal">--%</span></div>
                                        <div class="prog-v2-track">
                                            <div id="watch_RotBar" class="prog-v2-fill cyan" style="width: 0%"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Center: Tactical Alerts -->
                                <div class="v3-metric-col" style="flex: 1.5; padding: 0 20px;">
                                    <div id="secWatchIntel" class="intel-mini-feed">
                                        <div class="intel-line danger"><span data-i18n="det_vuln">DETECCIÓN:
                                                VULNERABILIDADES</span> <span id="watch_ThreatsCount">0</span></div>
                                        <div class="intel-line dim" data-i18n="heur_analysis">Análisis heurístico en
                                            curso...</div>
                                        <div class="intel-line highlight" style="margin-top: 20px;">SQLite Load: <span
                                                id="watch_SqliteLoad">0.00 MB</span></div>
                                        <div class="intel-line"><span data-i18n="sys_state">Estado del Sistema:</span>
                                            <span id="watch_SysState">ACTIVE</span>
                                        </div>
                                        <div class="intel-line"><span data-i18n="sec_nodes">Nodos de Seguridad:</span>
                                            <span id="watch_SecNodes">ACTIVE</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Right: Metrics -->
                                <div class="v3-metric-col" style="flex: 1;">
                                    <div class="v3-metric-box">
                                        <div class="v3-meta text-right">
                                            <div id="watch_HighRisk" class="v3-num red">0</div>
                                            <div class="v3-sub" data-i18n="high_risk">ALTO RIESGO</div>
                                        </div>
                                        <div class="v3-indicator-line red"></div>
                                    </div>
                                    <div class="v3-metric-box">
                                        <div class="v3-meta text-right">
                                            <div id="watch_Unused" class="v3-num">0</div>
                                            <div class="v3-sub" data-i18n="30d_unused">30D SIN USO</div>
                                        </div>
                                        <div class="v3-indicator-line gray"></div>
                                    </div>
                                    <div class="v3-metric-box">
                                        <div class="v3-meta text-right">
                                            <div id="watch_NeverRot" class="v3-num">0</div>
                                            <div class="v3-sub" data-i18n="never_rot">SIN ROTACIÓN</div>
                                        </div>
                                        <div class="v3-indicator-line gray"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TACTICAL BOTTOM NAVIGATION -->
                <div class="tactical-footer-nav">
                    <div class="nav-btn-v2" onclick="switchView('users')">
                        <span class="icon">👥</span>
                        <span class="label" data-i18n="users_nav"></span>
                    </div>
                    <div class="nav-btn-v2" onclick="openAuditModal()">
                        <span class="icon">📜</span>
