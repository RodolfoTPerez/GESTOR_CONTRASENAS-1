/* ========================
   TACTICAL DASHBOARD (v2.1)
   ======================== */
:root {
    --tactical-blue: var(--primary, #00f2ff);
    --tactical-teal: var(--secondary, #00ffcc);
    --tactical-danger: #ff003c;
    --tactical-warning: #ffab00;
    --tactical-dark: #0a0e14;
    --tactical-border: rgba(var(--primary-rgb, 0, 242, 255), 0.2);
    --tactical-glow: rgba(var(--primary-rgb, 0, 242, 255), 0.15);
    --glass-bg: rgba(var(--primary-rgb, 15, 20, 30), 0.2);
    --glass-border: rgba(255, 255, 255, 0.1);
    --glass-glow: rgba(var(--primary-rgb, 0, 242, 255), 0.2);
    --font-tactical: 'Rajdhani', sans-serif;
    --font-title: 'Orbitron', sans-serif;
    --font-mono: 'JetBrains Mono', 'Courier New', monospace;
    --text-main: #ffffff;
    --size-tactical: 11px;
    --size-value-lg: 32px;
    --size-title-sm: 13px;
}

#view-overview {
    padding: 30px;
    background: radial-gradient(circle at 50% 50%, #0d121b 0%, #010203 100%);
    font-family: var(--font-tactical);
    color: var(--text-main);
}

/* HEADER HUD */
.hud-header-v2 {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
    /* Increased from 25px for top space */
    padding: 10px 20px;
    background: var(--glass-bg);
    border-bottom: 2px solid var(--tactical-blue);
    backdrop-filter: blur(10px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
}

.hud-header-v2 .title-main {
    font-family: var(--font-title);
    font-size: 24px;
    letter-spacing: 4px;
    color: #fff;
    text-shadow: 0 0 10px var(--tactical-blue);
}

.hud-header-v2 .badge-security {
    background: var(--tactical-blue);
    color: #000;
    padding: 4px 12px;
    font-size: 10px;
    font-weight: 800;
    border-radius: 4px;
    letter-spacing: 1px;
}

/* 3-ROW GRID SYSTEM */
.dashboard-layout-v2 {
    display: flex;
    flex-direction: column;
    gap: 55px;
    /* Balanced space */
    height: calc(100% - 80px);
    overflow-y: auto;
    padding: 60px 20px 120px 20px;
    /* Increased top padding from 20px to 60px */
}

/* TOP STATS */
.stats-bento-row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin-bottom: 8px;
    /* Reduced from 15px */
    flex-shrink: 0;
}

.stat-card-v2 {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    padding: 8px 12px;
    /* Reduced from 10px */
    border-radius: 12px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4), 0 0 2px rgba(0, 242, 255, 0.1);
    text-align: center;
}

.stat-card-v2:hover {
    border-color: var(--tactical-blue);
    box-shadow: 0 0 20px var(--tactical-glow);
    transform: translateY(-2px);
}

.stat-card-v2::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    background: var(--tactical-blue);
}

.stat-card-v2 small {
    font-size: 0.65rem;
    /* Reduced from var(--size-tactical) */
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--tactical-blue);
    opacity: 0.8;
    display: block;
    margin-bottom: 2px;
    /* Reduced from 5px */
}

.stat-card-v2 .value {
    font-family: var(--font-title);
    font-size: 22px;
    /* Reduced from 24px */
    color: #fff;
    font-weight: 700;
    margin-top: 0;
    /* Reduced from 2px */
}

/* MIDDLE ROW: DYNAMIC HUD */
.middle-hud-row {
    display: grid;
    grid-template-columns: 1.2fr 1.8fr;
    gap: 30px;
    min-height: 344px;
    /* Reduced from 380px (8px grid) */
    margin-bottom: 10px;
    flex-shrink: 0;
}

/* GLOBAL RESET FOR FOCUS OUTLINES */
button:focus,
input:focus,
.nav-btn-v2:focus,
textarea:focus,
*[tabindex]:focus {
    outline: none !important;
    box-shadow: none;
    /* Let tactical styles handle active states */
}

.hud-pane {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    padding: 16px;
    /* Reduced from 25px */
    position: relative;
    backdrop-filter: blur(12px);
    box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.hud-pane:hover {
    border-color: var(--tactical-blue);
    box-shadow: 0 0 20px var(--tactical-glow);
    transform: translateY(-2px);
}

.hud-pane-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
    /* Reduced from 20px */
    border-bottom: 1px solid rgba(0, 242, 255, 0.1);
    padding-bottom: 8px;
    /* Reduced from 10px */
}

.hud-pane-header span:first-child {
    font-family: var(--font-title);
    font-size: var(--size-title-sm);
    letter-spacing: 2px;
    color: var(--tactical-blue);
    font-weight: 700;
    text-transform: uppercase;
    text-shadow: 0 0 10px var(--tactical-blue);
}

/* INTEL FEED */
.intel-feed {
    background: rgba(0, 10, 20, 0.6);
    border: 2px solid rgba(0, 242, 255, 0.2);
    padding: 12px;
    /* Reduced from 15px */
    border-radius: 12px;
    height: calc(100% - 30px);
    overflow-y: auto;
    position: relative;
    backdrop-filter: blur(10px);
    box-shadow:
        inset 0 0 30px rgba(0, 242, 255, 0.05),
        0 0 20px rgba(0, 242, 255, 0.1);
    border-right: 4px solid var(--tactical-blue);
}

.intel-feed::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%),
        linear-gradient(90deg, rgba(255, 0, 0, 0.05), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.05));
    background-size: 100% 4px, 3px 100%;
    pointer-events: none;
    opacity: 0.1;
    z-index: 2;
}

.intel-alert {
    background: linear-gradient(135deg, rgba(40, 0, 80, 0.4) 0%, rgba(20, 0, 40, 0.6) 100%);
    border: 1px solid rgba(130, 0, 255, 0.3);
    padding: 12px;
    /* Reduced from 18px */
    margin-bottom: 12px;
    /* Reduced from 20px */
    border-radius: 8px;
    position: relative;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(5px);
}

.intel-alert .alert-status-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: #ff003c;
    border-radius: 50%;
    margin-right: 10px;
    box-shadow: 0 0 10px #ff003c;
    border: 3px solid rgba(255, 0, 60, 0.2);
    /* Circle outline */
}

.intel-alert .alert-title {
    color: #fff;
    font-weight: 700;
    font-size: 11px;
    display: flex;
    align-items: center;
}

.intel-alert .alert-actions {
    display: flex;
    gap: 8px;
    margin-top: 12px;
}

.intel-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    font-size: 8px;
    padding: 5px 12px;
    cursor: pointer;
    text-transform: uppercase;
    font-family: var(--font-title);
    border-radius: 4px;
    transition: all 0.2s;
}

.intel-btn:hover {
    background: var(--tactical-blue);
    border-color: var(--tactical-blue);
    color: #000;
    box-shadow: 0 0 10px var(--tactical-blue);
}

.intel-btn:hover {
    background: var(--tactical-blue);
    color: #000;
}

.bottom-metrics-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
}

.metric-card-small {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    padding: 12px;
    /* Reduced from 15px for compaction */
    min-height: 200px;
    display: flex;
    flex-direction: column;
    backdrop-filter: blur(8px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.metric-card-small:hover {
    border-color: var(--tactical-blue);
    box-shadow: 0 0 20px var(--tactical-glow);
    transform: translateY(-2px);
}

.metric-card-small h4 {
    font-family: var(--font-title);
    font-size: var(--size-title-sm);
    letter-spacing: 2px;
    color: var(--tactical-blue);
    margin-bottom: 12px;
    /* Reduced from 15px */
    border-bottom: 1px solid rgba(0, 242, 255, 0.05);
    padding-bottom: 5px;
    text-transform: uppercase;
}

.prog-v2-header {
    font-family: var(--font-tactical);
    font-size: var(--size-tactical);
    display: flex;
    justify-content: space-between;
    margin-bottom: 2px;
    color: var(--text-dim);
}

/* RECTANGULAR FOOTER NAV */
.tactical-footer-nav {
    position: fixed;
    bottom: 0;
    left: 260px;
    /* sidebar width */
    right: 0;
    height: 64px;
    /* 8px Grid (8*8) */
    background: rgba(5, 8, 12, 0.95);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 32px;
    /* 8px Grid (4*8) */
    border-top: 1px solid var(--tactical-border);
    backdrop-filter: blur(10px);
    /* Design Rule: 10px standard */
    z-index: 1000;
}

.nav-btn-v2 {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    opacity: 0.7;
    min-width: 88px;
    /* 8px Grid (11*8) */
    height: 100%;
    padding: 0 16px;
    /* 8px Grid (2*8) */
    background: var(--glass-bg);
    /* Use zero-hardcode variable */
    border: 1px solid transparent;
    border-radius: 8px;
    /* 8px Grid */
}

.nav-btn-v2:hover {
    opacity: 1;
    transform: translateY(-4px);
    /* 8px Grid proportional */
    background: rgba(var(--primary-rgb, 0, 242, 255), 0.1);
    border-color: var(--tactical-blue);
    box-shadow: 0 0 16px var(--tactical-glow);
}

.nav-btn-v2.active {
    opacity: 1;
    background: rgba(var(--primary-rgb, 0, 242, 255), 0.2);
    /* Rule: 0.2 transparency */
    border-color: var(--tactical-blue);
    box-shadow: 0 0 24px var(--tactical-glow);
}

.nav-btn-v2 .icon {
    font-size: 20px;
    filter: drop-shadow(0 0 5px rgba(255, 255, 255, 0.2));
    transition: all 0.3s;
}

.nav-btn-v2:hover .icon {
    filter: drop-shadow(0 0 10px var(--tactical-blue));
    transform: scale(1.1);
}

.nav-btn-v2 .label {
    font-family: var(--font-tactical);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-main);
    /* Harmonized to white for legibility */
    opacity: 0.8;
    margin-top: 2px;
}

.nav-btn-v2:hover .label {
    opacity: 1;
    text-shadow: 0 0 8px var(--tactical-blue);
}

/* ACTIVITY LOG REDESIGN */
.activity-filter-group {
    display: flex;
    gap: 10px;
}

.activity-filter-group .nav-btn-v2 {
    padding: 8px 18px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--text-dim);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 6px;
    opacity: 0.8;
}

.activity-filter-group .nav-btn-v2:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.2);
    opacity: 1;
    transform: none;
    /* Override default floating hover */
}

.activity-filter-group .nav-btn-v2.active {
    background: rgba(0, 242, 255, 0.05);
    color: var(--tactical-blue);
    border-color: var(--tactical-blue);
    opacity: 1;
    box-shadow: 0 0 10px rgba(0, 242, 255, 0.15);
}

.tac-input:focus {
    border-color: var(--primary);
    outline: none;
    box-shadow: 0 0 10px rgba(0, 242, 255, 0.2);
}

.tac-input.error-border {
    border-color: var(--danger) !important;
    box-shadow: 0 0 10px rgba(255, 51, 51, 0.3) !important;
}

.v-btn-icon {
    background: none;
    border: none;
    font-size: 1.2rem;
    cursor: pointer;
    opacity: 0.7;
    transition: 0.2s;
    padding: 5px;
}

.activity-search-input {
    display: flex;
    align-items: center;
    background: var(--glass-bg);
    border: 1px solid var(--tactical-blue);
    border-radius: 6px;
    padding: 8px 16px;
    width: 350px;
    transition: all 0.3s ease;
    box-shadow: 0 0 10px rgba(0, 242, 255, 0.05);
}

.activity-search-input:focus-within {
    box-shadow: 0 0 15px rgba(0, 242, 255, 0.2);
}

.activity-search-input i {
    color: var(--tactical-blue);
    font-size: 14px;
    margin-right: 12px;
    opacity: 0.8;
}

.activity-search-input input {
    width: 100%;
    background: transparent;
    border: none;
    color: var(--text-main);
    font-family: var(--font-tactical);
    font-size: 13px;
    letter-spacing: 1px;
    outline: none;
}

.activity-search-input input::placeholder {
    color: var(--text-dim);
    opacity: 0.6;
}

/* ACTIVITY TABLE (WIDE LAYOUT) */
.activity-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 0.75rem;
}

.activity-table th {
    text-align: left;
    padding: 18px 20px;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-dim);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.activity-table td {
    padding: 16px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.02);
    vertical-align: middle;
}

.activity-table tr:hover {
    background: rgba(255, 255, 255, 0.02);
}

/* ACTIVITY BADGES */
.activity-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-align: center;
    min-width: 80px;
}

.activity-badge.success {
    background: transparent;
    border: 1px solid var(--success);
    color: var(--success);
}

.activity-badge.danger {
    background: transparent;
    border: 1px solid var(--danger);
    color: var(--danger);
}

/* ULTRA-COMPACT SYNC MINI CARD */
.sync-mini-card {
    position: fixed;
    bottom: 80px;
    /* Above the footer hub */
    right: 30px;
    width: 260px;
    background: rgba(5, 10, 20, 0.9);
    border: 1px solid var(--tactical-blue);
    border-radius: 8px;
    padding: 12px 15px;
    backdrop-filter: blur(15px);
    box-shadow: 0 5px 25px rgba(0, 242, 255, 0.2);
    display: none;
    /* Controlled by JS */
    flex-direction: column;
    z-index: 2000;
    border-left: 3px solid var(--tactical-blue);
}

.mini-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.mini-card-header span {
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--tactical-blue);
    font-weight: 700;
}

#syncPercent {
    color: #fff;
    text-shadow: 0 0 8px var(--tactical-blue);
}

.mini-progress-track {
    height: 4px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 8px;
}

.mini-progress-fill {
    height: 100%;
    width: 0%;
    background: var(--tactical-blue);
    box-shadow: 0 0 10px var(--tactical-blue);
    transition: width 0.3s ease;
}

.mini-status-text {
    font-size: 9px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* PROGRESS BARS V2 */
.prog-v2-container {
    margin-bottom: 12px;
}

.prog-v2-header {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    /* Increased to 11px */
    margin-bottom: 6px;
    /* More air */
    color: rgba(255, 255, 255, 0.8);
    font-weight: 600;
}

.prog-v2-track {
    height: 3px;
    /* Slightly thicker */
    background: rgba(255, 255, 255, 0.05);
    border-radius: 2px;
    overflow: hidden;
}

/* ... existing fill styles ... */

#secWatchCard .v3-metric-col {
    gap: 25px !important;
    /* Force more space in Security Watch card */
    height: auto !important;
}

#secWatchCard .v3-metric-box {
    margin-bottom: 10px;
}

#secWatchCard .v3-sub {
    font-size: 11px;
    /* Larger sub-labels */
    letter-spacing: 1px;
}

.prog-v2-fill {
    height: 100%;
    background: var(--tactical-blue);
    box-shadow: 0 0 15px var(--tactical-blue);
    transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
}

.prog-v2-fill.cyan {
    background: #00f2ff;
    box-shadow: 0 0 10px #00f2ff;
}

.prog-v2-fill.teal {
    background: #00ffcc;
    box-shadow: 0 0 10px #00ffcc;
}

.prog-v2-fill.red {
    background: #ff003c;
    box-shadow: 0 0 10px #ff003c;
}

.prog-v2-fill.amber {
    background: #ffab00;
    box-shadow: 0 0 10px #ffab00;
}

/* INTEL MINI FEED (Security Watch) */
.intel-mini-feed {
    font-size: 11px;
    line-height: 1.8;
    font-family: var(--font-mono);
    color: var(--tactical-blue);
    padding: 18px;
    background: rgba(0, 242, 255, 0.03);
    border: 1px solid rgba(0, 242, 255, 0.1);
    border-radius: 8px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.intel-line {
    margin-bottom: 4px;
    opacity: 0.9;
}

.intel-line.danger {
    color: var(--tactical-danger);
    font-weight: 700;
    font-size: 12px;
}

.intel-line.highlight {
    color: var(--tactical-teal);
    font-weight: 600;
}

.intel-line.dim {
    opacity: 0.5;
    font-size: 10px;
}

@keyframes radarRipple {
    0% {
        transform: translate(-50%, -50%) scale(0.2);
        opacity: 0;
    }

    50% {
        opacity: 0.4;
    }

    100% {
        transform: translate(-50%, -50%) scale(1.2);
        opacity: 0;
    }
}

.radar-ripple {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    border: 2px solid var(--tactical-blue);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    animation: radarRipple 4s infinite cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 0 15px var(--tactical-blue);
    will-change: transform, opacity;
}

.radar-ripple:nth-child(2) {
    animation-delay: 2s;
}

#radarSpiderChart polygon {
    filter: drop-shadow(0 0 8px var(--tactical-blue));
    will-change: points, fill, stroke;
}

.spider-chart-container {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
    width: 100%;
    position: relative;
}

.orbital-labels {
    position: absolute;
    width: 100%;
    height: 100%;
    pointer-events: none;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--text-dim);
    font-family: var(--font-title);
}

.o-label {
    position: absolute;
    transform: translate(-50%, -50%);
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
    color: #ffffff;
    /* White in mockup */
}

.o-label.top {
    top: 5%;
    left: 50%;
}

.o-label.tl {
    top: 20%;
    left: 20%;
}

.o-label.tr {
    top: 20%;
    left: 80%;
}

.o-label.ml {
    top: 50%;
    left: 15%;
}

.o-label.mr {
    top: 50%;
    left: 85%;
}

.o-label.bl {
    top: 80%;
    left: 20%;
}

.o-label.br {
    top: 80%;
    left: 80%;
}

.o-label.bottom {
    top: 92%;
    left: 50%;
    color: #ffffff;
}

.o-label span {
    display: inline-block;
    min-width: 35px;
    font-size: 9px;
    margin-left: 5px;
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    text-shadow: 0 0 10px currentColor;
}

.radar-status-text {
    position: absolute;
    bottom: -15px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 9px;
    letter-spacing: 3px;
    color: var(--text-dim);
    opacity: 0.8;
}

.radar-container {
    width: 180px;
    height: 180px;
    position: relative;
    border-radius: 50%;
    background:
        radial-gradient(circle, rgba(0, 242, 255, 0.08) 0%, transparent 80%),
        linear-gradient(rgba(0, 242, 255, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 242, 255, 0.05) 1px, transparent 1px);
    background-size: 100% 100%, 20px 20px, 20px 20px;
    background-position: center;
    border: 2px solid rgba(0, 242, 255, 0.15);
    overflow: hidden;
    backdrop-filter: blur(4px);
    box-shadow:
        inset 0 0 40px rgba(0, 242, 255, 0.2),
        0 0 20px rgba(0, 242, 255, 0.1);
    will-change: transform;
}

.radar-sweep {
    position: absolute;
    width: 100%;
    height: 100%;
    background: conic-gradient(from 0deg, var(--tactical-blue) 0deg, transparent 150deg);
    opacity: 0.3;
    animation: radarSweepRotate 3s linear infinite;
    transform-origin: center;
    filter: drop-shadow(0 0 15px var(--tactical-blue));
    will-change: transform;
}

.radar-circle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(0, 242, 255, 0.1);
    border-radius: 50%;
    width: 100%;
    height: 100%;
    box-shadow: 0 0 10px rgba(0, 242, 255, 0.05);
}

.radar-crosshair-h,
.radar-crosshair-v {
    position: absolute;
    background: rgba(0, 242, 255, 0.15);
}

.radar-crosshair-h {
    width: 100%;
    height: 1px;
    top: 50%;
}

.radar-crosshair-v {
    width: 1px;
    height: 100%;
    left: 50%;
}

.radar-center-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4px;
    height: 4px;
    background: var(--tactical-blue);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 10px var(--tactical-blue);
    z-index: 5;
}

.radar-crosshair-d1,
.radar-crosshair-d2 {
    position: absolute;
    width: 1px;
    height: 100%;
    background: rgba(0, 242, 255, 0.1);
    left: 50%;
    top: 0;
}

.radar-crosshair-d1 {
    transform: rotate(45deg);
}

.radar-crosshair-d2 {
    transform: rotate(135deg);
}


/* RADAR BLIP */
.radar-blip {
    position: absolute;
    width: 8px;
    height: 8px;
    background: var(--tactical-danger);
    border-radius: 50%;
    box-shadow: 0 0 15px var(--tactical-danger);
    animation: blipPulse 1.5s infinite;
}

@keyframes blipPulse {
    0% {
        opacity: 0;
        transform: scale(0.5);
    }

    50% {
        opacity: 1;
        transform: scale(1.2);
        box-shadow: 0 0 20px var(--tactical-danger), 0 0 40px var(--tactical-danger);
    }

    100% {
        opacity: 0;
        transform: scale(1.8);
    }
}

.value-large-display {
    font-size: var(--size-value-lg);
    color: #fff;
    font-weight: 700;
}

.row-tactical-text {
    display: flex;
    justify-content: space-between;
    font-size: var(--size-tactical);
    margin-bottom: 6px;
    color: var(--text-main);
    opacity: 0.9;
}

.mono-value {
    font-family: var(--font-mono);
    font-size: var(--size-tactical);
    font-weight: 700;
}

.security-metrics-side {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-family: var(--font-tactical);
}

/* PASSWORD HEALTH HUD PARITY */
#v3HealthCard {
    --v3-accent: var(--tactical-blue);
    /* Theme Default */
    transition: all 0.4s ease;
}

#v3HealthCard.is-good {
    --v3-accent: var(--tactical-teal);
}

#v3HealthCard.is-warning {
    --v3-accent: var(--tactical-warning);
}

#v3HealthCard.is-critical {
    --v3-accent: var(--tactical-danger);
}

/* Match the exact h4 style of the adjacent cards */
.v3-health-card h4 {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(0, 242, 255, 0.05);
    padding-bottom: 5px;
    margin-bottom: 40px;
    /* Even more space from header */
}

.v3-pill-btn {
    background: rgba(0, 242, 255, 0.05);
    border: 1px solid rgba(0, 242, 255, 0.3);
    color: var(--v3-accent);
    border-radius: 4px;
    /* Standard HUD button style */
    padding: 4px 12px;
    font-family: var(--font-title);
    font-size: 9px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.v3-pill-btn:hover {
    background: var(--tactical-teal);
    color: #000;
    box-shadow: 0 0 10px var(--tactical-teal);
}

.v3-main-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-grow: 1;
    padding: 0 15px;
}

.v3-metric-col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    /* Push groups to absolute top/bottom */
    height: 160px;
    /* Explicit height to force the separation */
}

.v3-metric-box {
    display: flex;
    align-items: center;
    gap: 15px;
    /* More horizontal space between line and text */
}

.v3-indicator-line {
    width: 3px;
    height: 35px;
    border-radius: 2px;
}

.v3-indicator-line.red {
    background: var(--tactical-danger);
    box-shadow: 0 0 8px var(--tactical-danger);
}

.v3-indicator-line.teal {
    background: var(--tactical-teal);
    box-shadow: 0 0 8px var(--tactical-teal);
}

.v3-indicator-line.gray {
    background: rgba(255, 255, 255, 0.1);
}

.v3-num {
    font-family: var(--font-title);
    font-size: 28px;
    line-height: 1;
    font-weight: 700;
    color: var(--v3-accent);
}

.v3-num.red {
    color: var(--tactical-danger);
}

.v3-num.teal {
    color: var(--tactical-teal);
}

.v3-sub {
    font-family: var(--font-title);
    font-size: 8px;
    color: var(--text-dim);
    letter-spacing: 1px;
}

.v3-gauge-col {
    display: flex;
    justify-content: center;
    align-items: center;
}

.v3-gauge-wrap {
    position: relative;
    width: 140px;
    height: 140px;
}

.v3-gauge-bg {
    fill: none;
    stroke: rgba(255, 255, 255, 0.05);
    stroke-width: 6;
}

.v3-gauge-fill {
    fill: none;
    stroke: var(--v3-accent);
    stroke-width: 8;
    transition: stroke 0.5s, stroke-dashoffset 1s cubic-bezier(0.4, 0, 0.2, 1);
    transform: rotate(-90deg);
    transform-origin: center;
    filter: drop-shadow(0 0 10px var(--v3-accent));
}

.v3-score-wrap {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
}

.v3-score-num {
    font-family: var(--font-title);
    font-size: 48px;
    font-weight: 700;
    line-height: 1;
    color: #fff;
    text-shadow: 0 0 20px var(--v3-accent);
    transition: all 0.5s;
}

.v3-score-label {
    font-family: var(--font-title);
    font-size: 9px;
    color: var(--text-dim);
    letter-spacing: 2px;
    margin-top: -5px;
}

.v3-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 25px;
    padding-top: 15px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
}

.v3-status-dots {
    display: flex;
    align-items: center;
    gap: 6px;
}

.v3-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
}

.v3-dot.active {
    background: var(--v3-accent);
    box-shadow: 0 0 8px var(--v3-accent);
}

.v3-status-label {
    font-family: var(--font-title);
    font-size: 10px;
    font-weight: 700;
    margin-left: 8px;
    color: var(--v3-accent);
}

.v3-timestamp {
    font-family: var(--font-tactical);
    font-size: 10px;
    color: rgba(255, 255, 255, 0.3);
}

/* TACTICAL SCROLLBAR V2 */
#view-overview::-webkit-scrollbar {
    width: 4px;
}

#view-overview::-webkit-scrollbar-thumb {
    background: var(--tactical-blue);
    border-radius: 2px;
}

/* GHOST EXPLANATION DIALOG */
.ghost-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(5, 8, 12, 0.65);
    /* More transparent */
    backdrop-filter: blur(4px);
    /* Softer blur */
    z-index: 5000;
    display: none;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.ghost-overlay.active {
    display: flex;
    opacity: 1;
}

.ghost-card {
    width: 500px;
    background: rgba(15, 23, 42, 0.95);
    border: 1px solid rgba(0, 242, 255, 0.2);
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 0 50px rgba(0, 0, 0, 0.8), 0 0 20px rgba(0, 242, 255, 0.1);
    transform: scale(0.9);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
}

.ghost-overlay.active .ghost-card {
    transform: scale(1);
}

.ghost-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
    border-bottom: 1px solid rgba(0, 242, 255, 0.1);
    padding-bottom: 15px;
}

.ghost-title-row {
    display: flex;
    align-items: center;
    gap: 12px;
}

.ghost-glyph {
    color: var(--tactical-blue);
    font-size: 18px;
    text-shadow: 0 0 10px var(--tactical-blue);
}

.ghost-title {
    font-family: var(--font-title);
    font-size: 14px;
    letter-spacing: 3px;
    color: #fff;
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.5);
}

.ghost-close {
    font-size: 24px;
    color: rgba(255, 255, 255, 0.4);
    cursor: pointer;
    transition: color 0.2s;
}

.ghost-close:hover {
    color: var(--tactical-danger);
}

.ghost-body {
    font-family: var(--font-tactical);
    font-size: 14px;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.8;
    max-height: 400px;
    overflow-y: auto;
}

.ghost-body b {
    color: var(--tactical-teal);
    font-weight: 700;
}

.ghost-body p {
    margin-bottom: 15px;
}

.ghost-footer {
    margin-top: 25px;
    display: flex;
    align-items: center;
    gap: 15px;
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--tactical-blue);
    opacity: 0.6;
}

.ghost-line {
    flex-grow: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--tactical-blue), transparent);
}

/* DYNAMIC GHOST VERDICT */
.ghost-verdict {
    margin-top: 15px;
    padding: 10px;
    background: rgba(0, 0, 0, 0.4);
    border-left: 3px solid var(--tactical-teal);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #fff;
    border-radius: 0 4px 4px 0;
}

.ghost-verdict span {
    color: var(--tactical-teal);
    font-weight: bold;
}

.ghost-verdict.safe {
    border-left-color: var(--tactical-teal);
}

.ghost-verdict.safe span {
    color: var(--tactical-teal);
}

.ghost-verdict.warning {
    border-left-color: var(--tactical-warning);
}

.ghost-verdict.warning span {
    color: var(--tactical-warning);
}

.ghost-verdict.danger {
    border-left-color: var(--tactical-danger);
    background: rgba(255, 0, 60, 0.1);
}

.ghost-verdict.danger span {
    color: var(--tactical-danger);
}